# Copy to .env (never commit it) and fill in the values.
# Variable names only — no secrets belong in this example file.

# SENAITE
SENAITE_BASE_URL=http://localhost:8080/SENAITE
SENAITE_USER=
SENAITE_PASSWORD=

# InvenTree
INVENTREE_BASE_URL=https://inventory.example.org
INVENTREE_TOKEN=

# Telegram (optional)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# SMTP (optional)
SMTP_PASSWORD=

# n8n or any other webhook (optional)
N8N_WEBHOOK_URL=

# Bearer token for POST /jobs/* and health probes
BRIDGE_TOKEN=
